                  "key": "status",
                  "value": "Todo",
                  "disabled": true
                },
                {
                  "key": "priority",
                  "value": "High",
                  "disabled": true
                },
                {
                  "key": "sortBy",
                  "value": "createdAt",
                  "disabled": true
                },
                {
                  "key": "sortOrder",
                  "value": "desc",
